{
  "name": "credisure_backend",
  "version": "1.0.0",
  "description": "Backend for CrediSure",
  "main": "index.js",
  "engines": {
    "comment": "Node 26 removed buffer.SlowBuffer, which jsonwebtoken depends on via jwa -> buffer-equal-constant-time. The server cannot start on Node >= 26.",
    "node": ">=20 <26"
  },
  "scripts": {
    "dev": "node src/server.js",
    "test": "npm run test:node && npm run test:py",
    "test:node": "node --test",
    "test:py": "OMP_NUM_THREADS=1 ../.venv/bin/python -m pytest tests -v"
  },
  "keywords": [
    "backend",
    "java",
    "script"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@sentry/node": "^10.70.0",
    "@sentry/profiling-node": "^10.70.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.1",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  }
}
