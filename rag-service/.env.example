# Copy this file to rag_service/.env and fill in the real value.
# rag_service/.env is gitignored -- never commit the real key.

# Required. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides -- defaults shown.
# GROQ_MODEL=openai/gpt-oss-20b
# RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG_RETRIEVER_K=3
# CORS_ORIGIN=http://localhost:3000
# RAG_LLM_REQUEST_TIMEOUT_S=30
# RAG_RATE_LIMIT_WINDOW_S=900
# RAG_RATE_LIMIT_MAX=20
# RAG_MAX_QUERY_LENGTH=2000
